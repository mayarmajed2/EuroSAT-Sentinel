# ByteCode & Trash / OS files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Raw Datasets & Heavy Model Checkpoints (Do NOT commit large binaries)
data/raw/
data/processed/
data/cache/
outputs/checkpoints/*.pth
outputs/checkpoints/*.pt
outputs/checkpoints/*.onnx
*.zip
*.tar.gz
*.tgz

# Keep tracked documentation, figures, metrics, and metadata splits
!outputs/figures/*.png
!outputs/metrics/*.json
!outputs/metrics/*.csv
!data/splits/*.csv
!data/README.md

# Secrets & Environment Variables
.env
.env.*
*.pem
*.key
credentials.json
