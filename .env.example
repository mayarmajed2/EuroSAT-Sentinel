# ==============================================================================
# EuroSAT-Sentinel — Environment Configuration Template (.env.example)
# Copy to .env if you wish to override default server or runtime settings.
# No external paid API keys or secret credentials are required to run this project.
# ==============================================================================

# Gradio Interactive Web Server Configuration
GRADIO_SERVER_NAME=127.0.0.1
# Leave unset or empty for automatic free-port selection (7860, 7861, ...)
# GRADIO_SERVER_PORT=7860

# Reproducibility & Compute
PYTHONHASHSEED=42
EUROSAT_CONFIG_PATH=configs/default_config.yaml
EUROSAT_CHECKPOINT_PATH=outputs/checkpoints/best_eurosat_model.pth
